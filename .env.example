# Database (MongoDB / Mongoose)
MONGODB_URI=""

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://whyte-automation-sandy.vercel.app"

# Cloudinary (REQUIRED for Admin product image upload - server side only)
# Copy the real values from https://console.cloudinary.com/settings/api-keys
# Never put the API secret in a NEXT_PUBLIC_* variable.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: public cloud name only, safe to expose to the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Transactional email (dealer registration success email, server-side only)
# Copy the real API key from https://resend.com/api-keys
# If unset, email sending is skipped (logged as a warning) — registration still succeeds.
RESEND_API_KEY=""
EMAIL_FROM="WHYTE <no-reply@whyte.co.in>"
# Shown in the email's "contact us" / Concierge links.
EMAIL_SUPPORT_ADDRESS="support@whyte.co.in"
# Optional: externally hosted hero image URL for the email. Omitted from the
# email entirely if unset (no broken image is ever shown).
EMAIL_HERO_IMAGE_URL=""
